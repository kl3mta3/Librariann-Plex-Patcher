<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>LibrariannPlexPatcher</AssemblyName>
    <RootNamespace>LibrariannPlexPatcher</RootNamespace>
    <ApplicationIcon>Assets\favicon.ico</ApplicationIcon>
    <!-- Launches asInvoker (the .NET default) - the visible window never needs admin rights.
         Only the on-demand relaunch in ElevatedActionRunner requests elevation, and only for the
         actual patch/restore file writes. -->

    <!-- Self-contained single-file publish: bundles the whole .NET runtime into one .exe so end users
         don't need .NET installed at all. Only affects `dotnet publish`, never `dotnet build`/F5
         debugging, so it's safe to set unconditionally here rather than needing a separate publish
         profile. Windows-only and win-x64-only on purpose - this tool only ever patches a Windows Plex
         install, there's no cross-platform case to support. WPF isn't trim-safe, so PublishTrimmed is
         deliberately left off (would break at runtime, not just bloat the exe). -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\patch-script-template.txt" LogicalName="LibrariannPlexPatcher.Assets.patch-script-template.txt" />
    <EmbeddedResource Include="Assets\static\logo-white-64.png" LogicalName="LibrariannPlexPatcher.Assets.static.logo-white-64.png" />
    <EmbeddedResource Include="Assets\static\logo-gold-64.png" LogicalName="LibrariannPlexPatcher.Assets.static.logo-gold-64.png" />
    <!-- Build action "Resource" (not EmbeddedResource) so WPF's pack:// URI in MainWindow.xaml's
         Window.Icon can resolve it directly - separate from the assets above, which are read via
         Assembly.GetManifestResourceStream instead. -->
    <Resource Include="Assets\favicon.ico" />
  </ItemGroup>

</Project>
